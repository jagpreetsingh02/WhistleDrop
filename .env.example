# ---------------------------------------------------------------------------
# WhistleDrop environment configuration
# Copy to .env and replace every value. Never commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/whistledrop

# JWT settings for moderator sessions.
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# bcrypt work factor for staff passwords (4-15). Keep 12+ outside tests.
BCRYPT_ROUNDS=12

# Number of reverse-proxy hops in front of the API (load balancer, ingress).
# 0 = the API is exposed directly. Set to 1 behind a single load balancer.
# Without this, every client shares one rate-limit bucket. Avoid "true".
TRUST_PROXY=0

# Privacy: reporter-originated timestamps are rounded down to this many
# minutes so an exact submission time cannot be matched to someone's activity.
# 0 disables coarsening (not recommended).
TIMESTAMP_BUCKET_MINUTES=15

# Privacy: closed reports (RESOLVED/DISMISSED) are deleted automatically this
# many days after closing, via a MongoDB TTL index. 0 keeps them forever.
RETENTION_DAYS_AFTER_CLOSE=365

# Comma-separated list of allowed CORS origins ("*" allows any origin)
CORS_ORIGIN=*

# Rate limiting (window in minutes + max requests per window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
REPORT_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_MAX=10
TRACK_RATE_LIMIT_MAX=20
REPORTER_MESSAGE_RATE_LIMIT_MAX=10
