# ---------------------------------------------------------------------------
# WhistleDrop environment configuration
# Copy to .env and replace every value. Never commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/whistledrop

# JWT settings for moderator sessions.
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=2h

# Comma-separated list of allowed CORS origins ("*" allows any origin)
CORS_ORIGIN=*

# Rate limiting (window in minutes + max requests per window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
REPORT_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_MAX=10
TRACK_RATE_LIMIT_MAX=20
